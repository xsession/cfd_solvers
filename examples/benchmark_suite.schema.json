{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cfd_solvers/example-benchmark-suite-v2.schema.json",
  "title": "cfd_solvers practical example benchmark suite v2",
  "type": "object",
  "required": ["schema", "timestamp_utc", "host", "build", "mode", "results"],
  "properties": {
    "schema": {"const": 2},
    "timestamp_utc": {"type": "string"},
    "host": {"type": "object"},
    "build": {"type": "object"},
    "environment": {"type": "object"},
    "mode": {
      "type": "object",
      "required": ["quick", "scale", "repeat"],
      "properties": {
        "quick": {"type": "boolean"},
        "scale": {"type": "integer", "minimum": 1},
        "repeat": {"type": "integer", "minimum": 1}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "feature_set", "case", "backend", "problem_size", "steps", "setup_ms", "simulation_ms", "work_units", "work_unit_name", "throughput", "checksum", "repeat", "target"],
        "properties": {
          "version": {"type": "string"},
          "feature_set": {"type": "string"},
          "case": {"type": "string"},
          "backend": {"type": "string"},
          "problem_size": {"type": "integer", "minimum": 1},
          "steps": {"type": "integer", "minimum": 1},
          "setup_ms": {"type": "number", "minimum": 0},
          "simulation_ms": {"type": "number", "minimum": 0},
          "total_ms": {"type": "number", "minimum": 0},
          "work_units": {"type": "number", "minimum": 0},
          "work_unit_name": {"type": "string"},
          "throughput": {"type": "number", "minimum": 0},
          "checksum": {"type": "number"},
          "repeat": {"type": "integer", "minimum": 0},
          "target": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
